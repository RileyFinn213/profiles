#!name=DNS缓存清理
#!desc=面板显示 Surge DNS 缓存状态；点击刷新按钮后调用 Surge API 清理并回读核验。
# 用法：启用模块后点击面板右上角刷新按钮；自动刷新只读状态，不自动清缓存。
#!category=uui
#!icon=arrow.triangle.2.circlepath

[Panel]
DNSCacheRefresh = title="DNS 清理缓存",content="缓存条目: -\n本地映射: -\n上次刷新: -\n点右上角 ⟳ 执行刷新",style=info,script-name=DNSCacheRefresh,update-interval=30

[Script]
DNSCacheRefresh = type=generic,script-path=https://raw.githubusercontent.com/RileyFinn213/profiles/main/Surge/Script/dns-refresh.js,script-update-interval=86400,timeout=20
