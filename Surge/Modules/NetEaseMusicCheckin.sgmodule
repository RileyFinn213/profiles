#!name=网易云音乐自动签到
#!desc=自动抓 Cookie，每天签到 + 领取 VIP 成长值，并定时听歌打卡。首次使用需开启 MITM 并打开一次网易云 App 抓 Cookie。脚本地址需替换为你自己托管的地址，见 README。打卡属刷量行为，有风控/封号风险，见 README。
#!category=签到
#!author=Muse
#!homepage=
#!icon=

# ============================================================
# 使用前必做：把下面三处 SCRIPT_URL 换成你托管 netease_checkin.js 的真实地址
# 例如：https://raw.githubusercontent.com/你的用户名/你的仓库/main/netease_checkin.js
# 不想打卡：删掉或在 Surge 里禁用「网易云音乐打卡」这条定时脚本即可
# ============================================================

[Script]
网易云音乐抓Cookie = type=http-request, pattern=^https?:\/\/(music|interface\.music)\.163\.com\/(weapi|eapi|api)\/, script-path=https://raw.githubusercontent.com/RileyFinn213/profiles/refs/heads/main/Surge/Script/netease_checkin.js, requires-body=false, max-size=0
网易云音乐签到 = type=cron, cronexp="12 8 * * *", script-path=https://raw.githubusercontent.com/RileyFinn213/profiles/refs/heads/main/Surge/Script/netease_checkin.js, timeout=180, wake-system=true, argument="mode=sign_vip"
网易云音乐打卡 = type=cron, cronexp="23 14 * * *", script-path=https://raw.githubusercontent.com/RileyFinn213/profiles/refs/heads/main/Surge/Script/netease_checkin.js, timeout=900, wake-system=true, argument="mode=daka"

[MITM]
hostname = %APPEND% music.163.com, interface.music.163.com
