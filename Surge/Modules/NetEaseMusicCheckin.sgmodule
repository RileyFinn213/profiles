#!name=网易云音乐自动签到
#!desc=多账号自动签到 + 领取 VIP 成长值 + 听歌打卡。首次使用需开启 MITM 并打开一次网易云 App 抓 Cookie（切号登录可添加多个账号）。功能开关、打卡首数、定时时间均可在下方参数里改。打卡属刷量行为，有风控/封号风险，见 README。
#!category=签到
#!author=Muse
#!homepage=
#!icon=
#!arguments=EnableSign:true,EnableVip:true,EnableDaka:true,DakaTarget:300,DakaExclude:,SignTime:12 8 * * *,DakaTime:23 14 * * *
#!arguments-desc=EnableSign=每日签到开关；EnableVip=成长值领取开关；EnableDaka=听歌打卡总开关（true 开 / false 关）；DakaTarget=每日打卡目标首数（上限 300）；DakaExclude=不打卡的账号昵称（填通知里显示的昵称，多个用 | 隔开，如 大号昵称；被排除的账号仍会签到和领成长值，只是跳过打卡；留空=全部账号都打卡）；SignTime / DakaTime=定时时间（cron：分 时 日 月 周）。改完参数后请停用再启用一次本模块让定时生效。

# ============================================================
# 脚本地址已填好（RileyFinn213/profiles 仓库 Surge/Script/netease_checkin.js）。
# 更新脚本时只需替换 GitHub 仓库里的同名文件，模块不用动；
# Surge 对远程脚本有缓存，更新后关开一次模块或稍等片刻即可生效。
# ============================================================

[Script]
网易云音乐抓Cookie = type=http-request, pattern=^https?:\/\/(music|interface\.music)\.163\.com\/(weapi|eapi|api)\/, script-path=https://raw.githubusercontent.com/RileyFinn213/profiles/refs/heads/main/Surge/Script/netease_checkin.js, requires-body=false, max-size=0
网易云音乐签到 = type=cron, cronexp="{{{SignTime}}}", script-path=https://raw.githubusercontent.com/RileyFinn213/profiles/refs/heads/main/Surge/Script/netease_checkin.js, timeout=300, wake-system=true, argument="mode=sign_vip&enableSign={{{EnableSign}}}&enableVip={{{EnableVip}}}&dakaExclude={{{DakaExclude}}}"
网易云音乐打卡 = type=cron, cronexp="{{{DakaTime}}}", script-path=https://raw.githubusercontent.com/RileyFinn213/profiles/refs/heads/main/Surge/Script/netease_checkin.js, timeout=1200, wake-system=true, argument="mode=daka&enableDaka={{{EnableDaka}}}&enableVip={{{EnableVip}}}&dakaTarget={{{DakaTarget}}}&dakaExclude={{{DakaExclude}}}"
网易云音乐账号重置 = type=generic, script-path=https://raw.githubusercontent.com/RileyFinn213/profiles/refs/heads/main/Surge/Script/netease_checkin.js, timeout=30, argument="mode=reset_accounts"

[MITM]
hostname = %APPEND% music.163.com, interface.music.163.com
